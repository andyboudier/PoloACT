# Hub (poloact.co.uk) — set these in Vercel → Settings → Environment Variables.

# Outgoing email. Resend is the sender for poloact.co.uk: verify the domain in
# the Resend dashboard (it gives you DKIM and return-path DNS records to add),
# then set the key. MAIL_FROM must be on the verified domain.
RESEND_API_KEY=
MAIL_FROM=PoloACT <hello@poloact.co.uk>

# Where the forms are delivered.
# The website's own demo-request form:
DEMO_RECIPIENT=hello@poloact.co.uk
# Tournament entries: one line per app, "clubId:email". Every app posts to the
# same route and this is the only thing that differs between them. Ids are the
# apps' own (see CLUB_ID in each app's source).
CLUB_RECIPIENTS=tppc:info@tedworthparkpolo.com,druids:office@example.com,vaux:office@example.com,demo:hello@poloact.co.uk
# Used when an app sends an id that is not in the map above.
ENTRY_RECIPIENT=hello@poloact.co.uk
# Origins allowed to post tournament entries (defaults to the demo and club apps).
ENTRY_ORIGINS=

# Fallback sender, used only when RESEND_API_KEY is not set: a Microsoft 365
# mailbox sent through Graph from an Azure app registration.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
DEMO_SENDER_UPN=

# Demo nightly reset (see app/api/demo-reset).
FIREBASE_SERVICE_ACCOUNT_JSON=
CRON_SECRET=

# Site metrics (see lib/google-auth.ts).
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
