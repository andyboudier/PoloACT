# Copy to .env for local development, or set these in Vercel → Settings →
# Environment Variables. With none of the VITE_FIREBASE_* values set, the demo
# runs entirely in the visitor's browser with a stand-in for sign-in.

# Firebase console → Project settings → Your apps → Web app. Not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated. These are always admins and can never be removed in-app.
VITE_ADMIN_EMAILS=andy@example.com

# Set to 1 once Sign in with Apple is configured in Firebase and Apple Developer.
VITE_AUTH_APPLE=
